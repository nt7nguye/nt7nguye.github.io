---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const day = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Tan Nguyen">
  <h1>Tan Nguyen</h1>
  <p class="sub">Software engineer in Toronto.</p>

  <h2>Writing</h2>
  <ul class="list">
    {posts.map((p) => <li><span>{day(p.data.date)}</span><a href={`/posts/${p.id}/`}>{p.data.title}</a></li>)}
  </ul>

  <h2>Work</h2>
  <ul class="list">
    <li><span>2025–now</span>WorkWhile, Senior SWE</li>
    <li><span>2023–2025</span>Secoda, Senior SWE</li>
    <li><span>2022</span>Datadog, SWE</li>
    <li><span>2022</span>Level, SWE</li>
    <li><span>2021</span>Shypyard, SWE</li>
    <li><span>2023</span>University of Waterloo, BCS</li>
  </ul>

  <footer>
    <a href="https://github.com/nt7nguye">GitHub</a> ·
    <a href="https://www.linkedin.com/in/nt7nguye/">LinkedIn</a>
  </footer>
</Base>

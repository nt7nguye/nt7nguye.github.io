---
const { value = "2*1+1%" } = Astro.props;
---
<div data-calculator>
  <input value={value} spellcheck="false" autocomplete="off" aria-label="Expression">
  <pre aria-live="polite"></pre>
</div>

<script>
  import { mount } from "./calc.js";
  document.querySelectorAll("[data-calculator]").forEach(mount);
</script>
